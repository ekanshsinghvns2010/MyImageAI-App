# Copy to .env and replace every REPLACE_ME value. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

# --- Database (docker-compose PostgreSQL) ---
POSTGRES_DB=myimageai
POSTGRES_USER=myimageai
POSTGRES_PASSWORD=REPLACE_ME_database_password

# --- Backend ---
# Bootstrap admin API key (used once to create client keys). The backend refuses values starting with REPLACE_ME or shorter than 32 chars.
ADMIN_BOOTSTRAP_API_KEY=REPLACE_ME_generate_with_openssl_rand_hex_32
# HMAC secret for expiring image URLs (required in the prod profile)
URL_SIGNING_SECRET=REPLACE_ME_generate_with_openssl_rand_hex_32
# Public URL clients use to reach the backend (used to build absolute image URLs); leave empty for relative URLs
PUBLIC_BASE_URL=
# Comma-separated browser origins allowed by CORS. Empty = no cross-origin browser access.
CORS_ALLOWED_ORIGINS=
SWAGGER_ENABLED=true

# --- AI provider ---
# mock | python-http | remote-http
AI_PROVIDER=python-http
AI_INFERENCE_URL=http://inference:8001
AI_MODEL_ID=myimageai-v1
# Shared bearer token between backend and inference server
AI_INFERENCE_TOKEN=REPLACE_ME_generate_with_openssl_rand_hex_32

# --- Inference server (read by inference-server, not by the Kotlin backend) ---
# mock | custom
INFERENCE_ADAPTER=mock
AI_MODEL_PATH=/models/latest.pt
