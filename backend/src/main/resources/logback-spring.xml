<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- key=value log lines with the request ID. Anything shaped like an API key is redacted from messages. -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%level logger=%logger{36} thread=%thread requestId=%X{requestId:-} msg=&quot;%replace(%msg){'mia_[A-Za-z0-9_-]{8,}', 'mia_[REDACTED]'}&quot;%n%ex{20}"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
